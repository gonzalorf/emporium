{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Emporium",
    "Audience": "Emporium",
    "Key": "<JWT_SECRET_FROM_ENV>",
    "ExpirationInMinutes": 60
  },

  "Events": {
    "Ttl": "36000"
  }
}
